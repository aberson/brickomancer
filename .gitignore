# Environment
.env

# Per-request scratch (ephemeral)
tmp/*
!tmp/.gitkeep

# Harness runtime output (reproduced by running run_harness.py)
tests/harness/runs/*
!tests/harness/runs/.gitkeep
tests/harness/scores.jsonl
tests/harness/server.log

# LPub3D render cache + PDF output generated next to fixture .ldr files by the
# toolchain smoke (regenerated on every run; never source).
tests/fixtures/LPub3D/
tests/fixtures/*_DPI.pdf

# Rebrickable data (re-downloaded via scripts/download_data.py)
data/rebrickable/*
!data/rebrickable/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / Frontend
node_modules/
frontend/dist/
frontend/node_modules/

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db
